# Comma-separated list of allowed frontend origins (Render + Vercel URLs)
ALLOWED_ORIGINS=https://tradeski.dev,https://www.tradeski.dev

# Secret used to sign user auth tokens. REQUIRED in production — set a long
# random value (e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`).
# If unset, a random per-process key is used and all sessions are invalidated
# on every restart.
SECRET_KEY=

# Postgres connection string for production persistence (e.g. a free Neon
# database). When set, accounts, portfolios, alerts, and watchlists are stored
# in Postgres and survive redeploys. When UNSET, the app falls back to a local
# SQLite file (data/prices.db) — fine for development, but Render's free tier
# wipes it on every redeploy/sleep, so set this in production.
# DATABASE_URL=postgresql://user:password@host/dbname

# Comma-separated list of stock symbols to track
STOCK_SYMBOLS=AAPL,MSFT,TSLA,NVDA,AMZN

# How often (in seconds) to fetch new prices
CHECK_INTERVAL=60

# Anthropic API key — required for Ski chatbot (get from console.anthropic.com)
ANTHROPIC_API_KEY=

# FRED API key — required for macro ribbon and Ski macro context
# Get a free key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# NewsAPI key — required for news sentiment panel and Ski news context
# Get a free key at https://newsapi.org/register (100 req/day free tier)
NEWS_API_KEY=

# Pushover push notifications (optional — leave blank to disable)
PUSHOVER_USER_KEY=
PUSHOVER_API_TOKEN=

# Render injects PORT automatically — do not set this manually
# PORT=5000
